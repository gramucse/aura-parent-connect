APP_NAME=Aditya University Parent Connect
ENVIRONMENT=demo

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security for Retell custom functions
AURA_TOOL_API_KEY=change-me

# Default demo DB: SQLite. For PostgreSQL, set DATABASE_URL.
DATABASE_URL=sqlite:///./aura_parent_connect_v2.db

# Optional admin dashboard protection (demo)
ADMIN_KEY=admin-demo-key
